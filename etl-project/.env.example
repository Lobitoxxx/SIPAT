# SIPAT-ETL — variables de entorno (copiar a .env y completar si aplica)
#
# El proyecto no usa credenciales en v1 (fuentes locales). Estas variables
# quedan preparadas para la fase de conectores REST/Database (sección 25 de la guía).
#
# Ruta de datos del workspace SIPAT (por defecto: parent de etl-project).
SIPAT_ROOT=..

# --- Conectores futuros (opcional) ---
# API_BASE_URL=
# API_TOKEN=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=sipat
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# --- MLflow (fase futura, sección 30) ---
# MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
# MLFLOW_EXPERIMENT_NAME=sipat-etl